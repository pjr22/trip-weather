OPENROUTESERVICE_API_KEY=`cat ../openRouteService_api_key.txt`
GEOAPIFY_API_KEY=`cat ../geoApify_api_key.txt`
NREL_API_KEY=`cat ../developer.nrel.gov_api_key.txt`
TRIP_EMAIL_URL=https://send.api.mailtrap.io/api/send
TRIP_EMAIL_APIKEY=`cat ../mailtrap_api_key.txt`
TRIP_EMAIL_FROM=tripweather@pjr22.com
TRIP_DB_PASSWORD=`cat ../trip_db_password.txt`
TRIP_REMEMBER_ME_KEY="$(openssl rand -base64 48)"

echo "Using OpenRouteService API key: $OPENROUTESERVICE_API_KEY"
echo "Using GeoApify API key: $GEOAPIFY_API_KEY"
echo "Using NREL API key: $NREL_API_KEY"
echo "Using Mailtrap API key: $TRIP_EMAIL_APIKEY"

docker run --name trip-weather \
 -p 9080:8080 -d \
 -e SERVER_PORT=8080 \
 -e OPENROUTESERVICE_API_KEY=${OPENROUTESERVICE_API_KEY} \
 -e GEOAPIFY_API_KEY=${GEOAPIFY_API_KEY} \
 -e NREL_API_KEY=${NREL_API_KEY} \
 -e TRIP_EMAIL_APIKEY=${TRIP_EMAIL_APIKEY} \
 -e TRIP_EMAIL_URL=${TRIP_EMAIL_URL} \
 -e TRIP_EMAIL_FROM=${TRIP_EMAIL_FROM} \
 -e TRIP_DB_URL=jdbc:postgresql://tripdb:5432/postgres \
 -e TRIP_DB_PASSWORD=${TRIP_DB_PASSWORD} \
 -e TRIP_REMEMBER_ME_KEY=${TRIP_REMEMBER_ME_KEY} \
 --net forgotten_net \
 org.pjr22/trip-weather:latest 
